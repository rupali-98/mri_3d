# Settings for compose.yaml. Copy to .env (git-ignored) and change what you need; every line has a default.
# Secrets don't go here: the API key is the file secrets/api_key.txt (see compose.yaml).

# Host ports
BACKEND_PORT=8080
FRONTEND_PORT=8501
MLFLOW_PORT=5001

# Largest upload the API accepts, in MB
HIPPO_MAX_MB=30

# PyTorch build for model-service: CUDA 12.8 by default; https://download.pytorch.org/whl/cpu for no GPU
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
